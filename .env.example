# ==============================================================================
# PhoneStore - Environment Variables Template
# ==============================================================================
# Sao chép file này thành `.env.local` cho môi trường phát triển cục bộ.
# Không commit file chứa secret key lên Git / GitHub.
# ==============================================================================

# Khóa bí mật dùng 1 lần để khởi tạo tài khoản Quản trị viên (Admin)
ADMIN_SETUP_TOKEN=your_secure_admin_setup_token_here

# (Tùy chọn) Cấu hình URL cơ sở khi chạy integration test
TEST_BASE_URL=http://127.0.0.1:5173

# Turso database (Vercel Marketplace tự cung cấp)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Tùy chọn: tên miền chính, ví dụ https://example.com
NEXT_PUBLIC_SITE_URL=
